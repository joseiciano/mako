# Template for `make envs ./path/to/.env` (terraform/Makefile).
#
# Usage:
#   1. Copy this file, e.g. `cp .env.example .env.staging.local`
#   2. Fill in values for ONE environment per file (staging OR production).
#   3. Run:  make envs ./.env.staging.local          (prompts for env)
#      or:   make envs SECRETS_ENV=staging ./.env.staging.local
#
# Only the keys below are accepted; anything else in the file is skipped as a
# safety guard. Empty values are also skipped. When adding a new secret,
# update scripts/set-github-env-secrets.sh, the allowlist in
# scripts/set-github-env-secrets-from-env.sh, and this template together.

# --- Infrastructure and Terraform state -------------------------------------

# 32-character Cloudflare account ID of this environment's account
CLOUDFLARE_ACCOUNT_ID=

# Account API token for CI: Terraform provider and Wrangler deploys. Never
# synced into a Worker.
CLOUDFLARE_API_TOKEN=

# Neon API key Terraform uses to manage the project, role, and database
NEON_API_KEY=

# Neon organization ID the Terraform project belongs to
NEON_ORG_ID=

# Access Key ID of the bucket-scoped R2 token for mako-terraform-state
# (Object Read & Write)
TF_STATE_R2_ACCESS_KEY_ID=

# Secret Access Key of the same R2 token (shown once at token creation)
TF_STATE_R2_SECRET_ACCESS_KEY=

# --- Applications ------------------------------------------------------------

# Account API token used by Workers at runtime; synced after deploy as the
# Worker secret named CLOUDFLARE_API_TOKEN
CLOUDFLARE_RUNTIME_API_TOKEN=

# Direct SSL Neon migration URI from `terraform output database_url`
DATABASE_URL=

# Hyperdrive config ID from `terraform output hyperdrive_id`
HYPERDRIVE_ID=

# Better Auth signing secret (long random string)
BETTER_AUTH_SECRET=

# Backend base URL Better Auth uses, e.g.
# https://mako-backend-rest.<subdomain>.workers.dev
BETTER_AUTH_URL=

# Comma-separated origins allowed by Better Auth, e.g.
# https://frontend-host,https://backend-host
BETTER_AUTH_TRUSTED_ORIGINS=

# Backend origin baked into the frontend at build time (same value as
# BETTER_AUTH_URL)
VITE_AUTH_BASE_URL=

# RealtimeKit application ID belonging to this environment's Cloudflare account
CLOUDFLARE_REALTIMEKIT_APP_ID=

# --- Stripe ------------------------------------------------------------------

# sk_test_... in staging, sk_live_... in production
STRIPE_SECRET_KEY=

# whsec_... registered for the /api/payments/webhook endpoint (optional;
# set when the payments webhook feature is enabled)
STRIPE_WEBHOOK_SECRET=

# pk_test_... in staging, pk_live_... in production
VITE_STRIPE_PUBLISHABLE_KEY=
