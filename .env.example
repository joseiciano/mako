# Environment template.
#
# LOCAL DEVELOPMENT (first section): copy to .env, then run `pnpm dev`.
#   cp .env.example .env
# `pnpm dev` starts local Postgres (Docker), runs migrations, and boots the
# backend, notification orchestrator, greedy matcher (wrangler, with local
# R2, Queues, Workflows, Hyperdrive) and the frontend. Defaults below work
# without edits; the values marked "placeholder" only matter for those flows.
#
# DEPLOYMENT (commented out below): prefer the environment-specific templates:
#   cp .env.staging.example .env.staging
#   cp .env.production.example .env.production
# Then run the matching targets described there. Filled .env, .env.staging and
# .env.production files are gitignored. NEVER commit secret values.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# Local Postgres started by docker-compose.dev.yml (port 54331). Also used as
# the local Hyperdrive origin and by `pnpm db:migrate`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54331/mako_dev

# Better Auth. Secret must be at least 32 characters; generate your own with
# `openssl rand -base64 32` if you prefer.
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3000
AUTH_EMAIL_VERIFICATION_ENFORCED=false

# Optional: send Cloudflare API calls (RealtimeKit, AI Gateway) to this base
# instead of https://api.cloudflare.com/client/v4. Leave unset for real calls.
# CLOUDFLARE_API_BASE_URL=

# Optional, `pnpm local:up` only: set to 1 to start the `fakes` service and
# point the local workers' Cloudflare API calls at it (RealtimeKit rooms and
# recordings answer locally with no external network). Off by default; leave
# unset to use real test-mode credentials. Takes effect on the next
# `pnpm local:up`.
# LOCAL_FAKES=1
#
# Optional: send Stripe API calls to this base (host, port and protocol) instead
# of https://api.stripe.com. `pnpm local:up` sets it to the stripe-mock container
# when LOCAL_FAKES is on; leave unset otherwise.
# STRIPE_API_BASE_URL=

# Origin the frontend dev server proxies /api to.
MAKO_BACKEND_API_ORIGIN=http://127.0.0.1:8787

# Placeholders: replace with real test-mode values to exercise these flows.
CLOUDFLARE_ACCOUNT_ID=local-placeholder
CLOUDFLARE_API_TOKEN=local-placeholder
CLOUDFLARE_REALTIMEKIT_APP_ID=local-placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ---------------------------------------------------------------------------
# Deployment (bootstrap, CI, GitHub environment secrets), commented out so it
# never overrides the local values above; uncomment in .env.staging or
# .env.production instead
# ---------------------------------------------------------------------------

# Bootstrap and CI credentials
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# NEON_API_KEY=
# NEON_ORG_ID=

# GitHub Environment variables (non-secret)
# EMAIL_SENDING_ZONE_ID=
# EMAIL_SENDING_DOMAIN=
# AUTH_EMAIL_VERIFICATION_ENFORCED=false

# Direct Neon URI for the mako_app role; migrations and Hyperdrive creation.
# DATABASE_URL=
# HYPERDRIVE_ID=

# Worker runtime and application secrets
# CLOUDFLARE_RUNTIME_API_TOKEN=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_TRUSTED_ORIGINS=
# VITE_AUTH_BASE_URL=
# CLOUDFLARE_REALTIMEKIT_APP_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
