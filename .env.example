# Generic environment template.
#
# Prefer the environment-specific templates:
#   cp .env.staging.example .env.staging
#   cp .env.production.example .env.production
#
# Then run the matching targets described there. Filled .env.staging and
# .env.production files are gitignored. NEVER commit secret values.

# Bootstrap and CI credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
NEON_ORG_ID=

# GitHub Environment variables (non-secret)
EMAIL_SENDING_ZONE_ID=
EMAIL_SENDING_DOMAIN=
AUTH_EMAIL_VERIFICATION_ENFORCED=false

# Direct Neon URI for the mako_app role; migrations and Hyperdrive creation.
DATABASE_URL=
HYPERDRIVE_ID=

# Worker runtime and application secrets
CLOUDFLARE_RUNTIME_API_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
VITE_AUTH_BASE_URL=
CLOUDFLARE_REALTIMEKIT_APP_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
