# Production environment — copy to .env.production (gitignored), fill in real
# values, then run:
#
#   make bootstrap-production .env.production   # one-time resource provisioning
#   make envs-production .env.production        # GitHub secrets + variables
#
# Or run both (for an already-complete file):
#   make setup-production .env.production
#
# This file is sourced as shell syntax by bootstrap-* targets. Quote values
# containing whitespace or shell metacharacters. NEVER commit the filled file.

# --- Bootstrap and CI credentials -------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
NEON_ORG_ID=

# --- Email Sending GitHub variables -----------------------------------------
EMAIL_SENDING_ZONE_ID=
EMAIL_SENDING_DOMAIN=
# Exact lowercase true or false. Keep false until production delivery is verified.
AUTH_EMAIL_VERIFICATION_ENFORCED=false

# --- Neon/Hyperdrive ---------------------------------------------------------
# On a fresh account, the first bootstrap prints these connection strings and
# stops before Hyperdrive creation. Paste the pooled URI here, set DATABASE_URL
# below to the direct URI, then re-run bootstrap-production.
HYPERDRIVE_CONNECTION_STRING=
DATABASE_URL=
# Set from the bootstrap summary after Hyperdrive exists.
HYPERDRIVE_ID=

# --- Worker runtime and application secrets ---------------------------------
CLOUDFLARE_RUNTIME_API_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
VITE_AUTH_BASE_URL=
CLOUDFLARE_REALTIMEKIT_APP_ID=

# --- Stripe live keys --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
