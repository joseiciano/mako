# Staging environment — copy to .env.staging (gitignored), fill in real
# values, then run:
#
#   make bootstrap-staging .env.staging   # one-time resource provisioning
#   make envs-staging .env.staging        # GitHub secrets + variables
#
# Or run both (for an already-complete file):
#   make setup-staging .env.staging
#
# This file is sourced as shell syntax by bootstrap-* targets. Quote values
# containing whitespace or shell metacharacters. NEVER commit the filled file.

# --- Bootstrap and CI credentials -------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
NEON_ORG_ID=

# --- Email Sending GitHub variables -----------------------------------------
EMAIL_SENDING_ZONE_ID=
EMAIL_SENDING_DOMAIN=

# --- Neon/Hyperdrive ---------------------------------------------------------
# Direct Neon URI for the mako_app role on the mako-staging project. Used both
# by migrations and, when the Hyperdrive config does not exist yet, to create
# it. On a fresh account, the first bootstrap prints this URI; paste it here
# and re-run bootstrap-staging.
DATABASE_URL=
# Set from the bootstrap summary after Hyperdrive exists.
HYPERDRIVE_ID=

# --- Worker runtime and application secrets ---------------------------------
CLOUDFLARE_RUNTIME_API_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
VITE_AUTH_BASE_URL=
CLOUDFLARE_REALTIMEKIT_APP_ID=

# --- Stripe staging keys (optional until testing payments) ------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
