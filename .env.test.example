# Test runtime configuration
NODE_ENV=test

# Isolated local Postgres database used for local test runs.
# The reset flow enforces localhost + a "_test" database name.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/mako_test

# Local service endpoints used by integration/smoke tests.
BACKEND_BASE_URL=http://127.0.0.1:8787
FRONTEND_BASE_URL=http://127.0.0.1:3000
