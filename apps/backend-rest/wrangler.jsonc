{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mako-backend-rest",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "__HYPERDRIVE_ID__"
    }
  ],
  "r2_buckets": [
    { "binding": "RECORDINGS_BUCKET", "bucket_name": "mako-recordings" },
    { "binding": "SCREENSHOTS_BUCKET", "bucket_name": "mako-screenshots" }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "notification-orchestration"
      }
    ]
  },
  "workflows": [
    {
      "binding": "SESSION_TIMER_WORKFLOW",
      "name": "session-timer-workflow",
      "class_name": "SessionTimerWorkflow"
    },
    {
      "binding": "RECORDING_FINALIZATION_WORKFLOW",
      "name": "recording-finalization-workflow",
      "script_name": "mako-notification-orchestrator",
      "class_name": "RecordingFinalizationWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "PREMIUM_MARKETPLACE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@example.invalid",
    "REALTIMEKIT_WEBHOOK_PUBLIC_KEY_URL": "https://api.realtime.cloudflare.com/.well-known/webhooks.json",
    "AUTH_EMAIL_VERIFICATION_ENFORCED": "false"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_TRUSTED_ORIGINS",
      "BETTER_AUTH_URL",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_REALTIMEKIT_APP_ID"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@example.invalid"]
    }
  ],
  // Query-string redaction is not supported in wrangler.jsonc at 4.73.0;
  // CI reasserts it after every deploy via scripts/ensure-redact-query-string.sh.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
