{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mako-backend-rest",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "__HYPERDRIVE_ID__"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTERVIEW_PROVISIONING_QUEUE",
        "queue": "interview-provisioning"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
