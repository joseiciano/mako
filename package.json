{
  "name": "mako",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:watch": "pnpm -r --parallel --if-present run test:watch",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:stack": "node ./scripts/test-env/test-stack.mjs",
    "test:stack:up": "pnpm run test:stack up",
    "test:stack:down": "pnpm run test:stack down",
    "test:stack:reset": "pnpm run test:stack reset",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean",
    "db:test:reset": "pnpm --filter @mako/shared-backend run db:test:reset",
    "db:migrate": "pnpm --filter @mako/shared-backend run db:migrate",
    "db:migration:create": "pnpm --filter @mako/shared-backend run db:migration:create"
  },
  "devDependencies": {
    "@types/node": "^22.18.11",
    "@vitest/coverage-v8": "^3.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
