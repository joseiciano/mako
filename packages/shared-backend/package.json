{
  "name": "@mako/shared-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:test:reset": "node ./scripts/reset-test-database.mjs && node ./scripts/run-migrations.mjs",
    "db:migrate": "node ./scripts/run-migrations.mjs",
    "db:migration:create": "node ./scripts/create-migration.mjs"
  },
  "dependencies": {
    "@mako/shared": "workspace:*",
    "hono": "^4.12.8",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
